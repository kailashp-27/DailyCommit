<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DailyCommit" android:textStyle="bold" android:textColor="#E8EAF0" android:textSize="15sp"/>
        <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open to begin" android:textColor="#FF8A3D" android:textSize="12sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_heatmap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:scaleType="fitCenter" android:contentDescription="Six months of habit commits. Tap to open DailyCommit for daily details."/>
    <LinearLayout android:id="@+id/widget_quick_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:text="More habits" android:textColor="#A3AAB9" android:textSize="11sp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to check in" android:textColor="#A3AAB9" android:textSize="10sp"/>
</LinearLayout>
